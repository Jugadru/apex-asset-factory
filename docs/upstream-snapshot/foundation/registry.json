        "owner.hosted.request"
      ],
      "restrictions": [
        "Hosted software rendering is not real GPU"
      ]
    },
    {
      "id": "release.test-build",
      "module": "release",
      "version": "1.0.0",
      "inputs": [
        "authorized exact SHA"
      ],
      "outputs": [
        "verified test artifact"
      ],
      "method": "Existing Release Lab",
      "permissions": [
        "owner.hosted.request"
      ],
      "restrictions": [
        "No publication"
      ]
    },
    {
      "id": "asset.build.original",
      "module": "asset-factory",
      "version": "0.1.0",
      "inputs": [
        "approved original vehicle request",
        "trusted Blender 5.3 executable",
        "trusted Godot 4.7.2 executable",
        "new workspace outside repository"
      ],
      "outputs": [
        "GLB staging",
        "report and registry receipts",
        "optional PNG"
      ],
      "method": "python3 tools/asset_factory/build.py REQUEST --blender BLENDER --godot GODOT --workspace NEW_WORKSPACE [--capture]",
      "permissions": [
        "read.local",
        "write.staging"
      ],
      "restrictions": [
        "No external asset sources",
        "No production promotion",
        "No authorization from metadata",
        "Exact-pair compatibility remains unverified by shared registry"
      ]
    }
