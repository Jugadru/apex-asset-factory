  "capabilities": [
    {
      "id": "foundation.validate",
      "module": "foundation",
      "version": "1.0.0",
      "inputs": [
        "repository registries"
      ],
      "outputs": [
        "structural report"
      ],
      "method": "python3 tools/apex_foundation_registry.py validate",
      "permissions": [
        "read.repository"
      ],
      "restrictions": [
        "No runtime writes; no execution authorization"
      ]
    },
    {
      "id": "foundation.search",
      "module": "foundation",
      "version": "1.0.0",
      "inputs": [
        "query"
      ],
      "outputs": [
        "historical catalog records"
      ],
      "method": "python3 tools/apex_foundation_registry.py search QUERY",
      "permissions": [
        "read.repository"
      ],
      "restrictions": [
        "Offline; sources not revalidated"
      ]
    },
    {
      "id": "foundation.compatibility",
      "module": "foundation",
      "version": "1.0.0",
      "inputs": [
        "two module IDs and exact versions"
      ],
      "outputs": [
        "compatibility decision"
      ],
      "method": "python3 tools/apex_foundation_registry.py compatibility LEFT VERSION RIGHT VERSION",
      "permissions": [
        "read.repository"
      ],
      "restrictions": [
        "Only explicit PASS allows compatibility; never grants execution"
      ]
    },
    {
      "id": "asset.plan",
      "module": "asset-factory",
      "version": "1.0.0",
      "inputs": [
        "asset job manifest"
      ],
      "outputs": [
        "non-executed plan"
      ],
      "method": "python3 tools/apex_foundation.py plan MANIFEST",
      "permissions": [
        "read.local"
      ],
      "restrictions": [
        "External sources blocked; no promotion"
      ]
    },
    {
      "id": "lab.request",
      "module": "lab-hub",
      "version": "1.0.0",
      "inputs": [
        "owner comment",
        "exact commit SHA"
      ],
      "outputs": [
        "hosted diagnostic receipt"
      ],
      "method": "/lab audit SHA",
      "permissions": [
        "owner.hosted.request"
      ],
      "restrictions": [
        "Existing Hub authorization applies; no personal runner"
      ]
    },
    {
      "id": "quality.fast",
      "module": "quality-lab",
      "version": "1.0.0",
      "inputs": [
        "PR diff"
      ],
      "outputs": [
        "CI logs"
      ],
      "method": ".github/workflows/godot-setup.yml",
      "permissions": [
        "read.repository"
      ],
      "restrictions": [
        "FAST exact SHA; no automatic FULL"
      ]
    },
    {
      "id": "saveguard.check",
      "module": "saveguard",
      "version": "1.0.0",
      "inputs": [
        "baseline and candidate revisions"
      ],
      "outputs": [
        "cross-revision report"
      ],
      "method": "Existing SaveGuard workflow",
      "permissions": [
        "read.repository"
      ],
      "restrictions": [
        "No production save modification"
      ]
    },
    {
      "id": "performance.report",
