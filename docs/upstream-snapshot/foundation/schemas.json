{
  "module.v1": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "version": {
        "type": [
          "string",
          "null"
        ]
      },
      "maturity": {
        "type": "string",
        "enum": [
          "existing",
          "experimental",
          "planned"
        ]
      },
      "state_owner": {
        "type": "string",
        "minLength": 1
      },
      "dependencies": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
        },
        "uniqueItems": true
      },
      "entrypoints": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      }
    },
    "required": [
      "id",
      "name",
      "version",
      "maturity",
      "state_owner",
      "dependencies",
      "entrypoints"
    ],
    "additionalProperties": false
  },
